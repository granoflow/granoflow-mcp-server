{
  "schema": "granoflow.device_shell_registry",
  "schemaVersion": 1,
  "description": "Canonical HTML/CSS device shells for consistent prototype frames across agents.",
  "defaults_by_layout_family": {
    "mobile_portrait": "iphone_17_pro_portrait_v1",
    "desktop_landscape": "macos_tahoe_window_v1",
    "tablet_portrait": "ipad_pro_11_portrait_v1",
    "tablet_landscape": "ipad_pro_11_landscape_v1"
  },
  "profiles": [
    {
      "id": "iphone_17_pro_portrait_v1",
      "layout_family_id": "mobile_portrait",
      "platform_ids": ["ios"],
      "label": "iPhone 17 Pro · portrait",
      "is_default_for_layout_family": true,
      "reference_viewport": { "width": 402, "height": 874, "dpr": 3 },
      "assets": {
        "css": "iphone-17-pro-portrait/device-shell.css",
        "frame_fragment": "iphone-17-pro-portrait/frame.html"
      },
      "required_attributes": {
        "data-device-shell": "iphone_17_pro_portrait_v1",
        "data-layout-family": "mobile_portrait"
      }
    },
    {
      "id": "android_phone_portrait_v1",
